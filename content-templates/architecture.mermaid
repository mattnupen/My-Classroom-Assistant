flowchart LR
    subgraph laptop["Your laptop — names never leave this box"]
        GB["Gradebook / LMS export"] --> APPS["Offline apps<br/>(browser, wifi optional)"]
        FB["Student feedback"] --> CLEAN["Feedback Cleaner"]
        APPS --> PULSE["Name-free pulse<br/>counts + tiers only"]
        CLEAN --> DIGEST["Name-free digest"]
    end
    PULSE --> T(("You"))
    DIGEST --> T
    T -->|"drop into my-classroom/pulses/"| AI["Your class's AI<br/>in Claude Cowork"]
    AI -->|"slides · cards · messages<br/>(aggregate-only, always)"| T
    T --> CLASS["Your class"]
    CLASS -.->|"anonymous feedback"| FB
    GB -. "Direct mode only, district-approved:<br/>my-classroom/inbox/" .-> AI
